# Ignore build artifacts and intermediate files
build/
install/
log/
.colcon/
ros2_ws/build/
ros2_ws/install/
ros2_ws/log/

# Ignore Python bytecode files
__pycache__/
*.pyc
*.pyo
*.pyd

# Ignore configuration files
config/local_setup.*
config/setup.*
config/_local_setup_util*
config/_setup_util*

# Ignore editor and IDE specific files
.idea/
.vscode/
*.swp
*~
.project
.cproject
*.launch.pyc
*.yamlc

# Ignore system files
.DS_Store
Thumbs.db

# Ignore environment and dependency management files
.env
.venv
*.env
*.venv

# Ignore test and temporary files
*.bak
*.tmp
*.temp

# Ignore any files generated by colcon test
test_results/
colcon_test_result/
colcon_last_tests_failed.log

# Ignore any personal settings or miscellaneous files
*.user
*.log

# Ignore ROS2 specific files
ament_tools.yaml
ament_dependencies

# Ignore binary files
*.exe
*.dll
*.so
*.dylib
*.bin
*.o
*.obj
