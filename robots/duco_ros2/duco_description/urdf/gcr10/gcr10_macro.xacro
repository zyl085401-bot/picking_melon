<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">
  <xacro:macro name="gcr10" params="prefix parent *origin kinematic_calibration_yaml_file">
    <!-- <xacro:include filename="$(find duco_description)/urdf/gcr10/gcr10.urdf" /> -->
    
    <xacro:property name="params" value="${xacro.load_yaml(kinematic_calibration_yaml_file)}" />

    <xacro:macro name="link" params="prefix name *inertial">
        <link name="${prefix}${name}">
          <xacro:insert_block name="inertial" />
          <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
              <mesh filename="package://duco_description/meshes/gcr10/visual/${name}.stl" />
            </geometry>
            <material name="">
              <color rgba="0.73333 0.78039 0.83922 1" />
            </material>
          </visual>
          <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
              <mesh filename="package://duco_description/meshes/gcr10/collision/${name}.stl" />
            </geometry>
          </collision>
        </link>
    </xacro:macro>

    <xacro:macro name="joint" params="name parent child *origin *axis *limit" >
      <joint name="${name}" type="revolute">
        <parent link="${parent}" />
        <child link="${child}" />
        <xacro:insert_block name="origin" />
        <xacro:insert_block name="axis" />
        <xacro:insert_block name="limit" />
      </joint>
    </xacro:macro>

    <joint name="${prefix}joint_base" type="fixed">
      <xacro:insert_block name="origin" />
      <parent link="${parent}" />
      <child link="${prefix}base_link" />
    </joint>

    <!-- <xacro:include filename="$(find duco_description)/urdf/gcr10/gcr10.urdf" /> -->
    <xacro:link prefix="${prefix}" name="base_link">
      <inertial>
        <origin
          xyz="5.4538E-05 0.0034249 0.036769"
          rpy="0 0 0" />
        <mass
          value="2" />
        <inertia
          ixx="0.010998"
          ixy="2.636E-05"
          ixz="3.0192E-06"
          iyy="0.012303"
          iyz="0.0003209"
          izz="0.01834" />
      </inertial>
    </xacro:link>
    
    <xacro:link prefix="${prefix}" name="link_1">
      <inertial>
        <origin xyz="-1.8439E-05 0.044555 0.031143" rpy="0 0 0" />
        <mass value="9.174" />
        <inertia ixx="0.00077995" ixy="-2.4048E-07" ixz="2.088E-08" iyy="0.0011568" iyz="-9.8677E-05" izz="0.001099" />
      </inertial>
    </xacro:link>

    <xacro:link prefix="${prefix}" name="link_2">
      <inertial>
        <origin
          xyz="0.37123 1.2834E-05 0.075398"
          rpy="0 0 0" />
        <mass
          value="16.09" />
        <inertia
          ixx="0.00082458"
          ixy="2.8918E-07"
          ixz="-2.889E-05"
          iyy="0.0008143"
          iyz="2.1221E-08"
          izz="0.0013433" />
      </inertial>
    </xacro:link>

    <xacro:link prefix="${prefix}" name="link_3">
      <inertial>
        <origin
          xyz="0.56866 -3.9836E-06 -0.10666"
          rpy="0 0 0" />
        <mass
          value="4.765" />
        <inertia
          ixx="0.00023909"
          ixy="1.4987E-08"
          ixz="-1.8702E-05"
          iyy="0.00023639"
          iyz="-5.1641E-09"
          izz="0.00042025" />
      </inertial>
    </xacro:link>

    <xacro:link prefix="${prefix}" name="link_4">
      <inertial>
        <origin
          xyz="4.248E-06 -0.019201 0.0028397"
          rpy="0 0 0" />
        <mass
          value="2.485" />
        <inertia
          ixx="0.00022756"
          ixy="-5.1654E-09"
          ixz="-1.4983E-08"
          iyy="0.00040418"
          iyz="1.8702E-05"
          izz="0.00023026" />
      </inertial>
    </xacro:link>

    <xacro:link prefix="${prefix}" name="link_5">
      <inertial>
        <origin
          xyz="-4.2469E-06 0.019201 0.0028397"
          rpy="0 0 0" />
        <mass
          value="2.485" />
        <inertia
          ixx="0.00022756"
          ixy="-5.1576E-09"
          ixz="1.4973E-08"
          iyy="0.00040418"
          iyz="-1.8702E-05"
          izz="0.00023026" />
      </inertial>
    </xacro:link>

    <xacro:link prefix="${prefix}" name="link_6">
      <inertial>
        <origin
          xyz="1.1309E-10 -6.6613E-16 -0.024173"
          rpy="0 0 0" />
        <mass
          value="0.451" />
        <inertia
          ixx="0.00044067"
          ixy="1.9605E-20"
          ixz="-3.1582E-19"
          iyy="0.00044067"
          iyz="-6.1088E-20"
          izz="0.00077308" />
      </inertial>
    </xacro:link>

    <xacro:joint name="${prefix}joint1" parent="${prefix}base_link" child="${prefix}link_1">
      <origin xyz="${params.kin_cali.joint1.xyz}" rpy="${params.kin_cali.joint1.rpy}" />
      <axis xyz="0 0 1" />
      <limit lower="-6.283185" upper="6.283185" effort="250" velocity="3.926" />
    </xacro:joint>

    <xacro:joint name="${prefix}joint2" parent="${prefix}link_1" child="${prefix}link_2">
      <origin xyz="${params.kin_cali.joint2.xyz}" rpy="${params.kin_cali.joint2.rpy}" />
      <axis xyz="0 0 1" />
      <limit lower="-6.283185" upper="6.283185" effort="250" velocity="3.926" />
    </xacro:joint>

    <xacro:joint name="${prefix}joint3" parent="${prefix}link_2" child="${prefix}link_3">
      <origin xyz="${params.kin_cali.joint3.xyz}" rpy="${params.kin_cali.joint3.rpy}" />
      <axis xyz="0 0 1" />
      <limit lower="-2.792527" upper="2.792527" effort="150" velocity="3.926" />
    </xacro:joint>

    <xacro:joint name="${prefix}joint4" parent="${prefix}link_3" child="${prefix}link_4">
      <origin xyz="${params.kin_cali.joint4.xyz}" rpy="${params.kin_cali.joint4.rpy}" />
      <axis xyz="0 0 1" />
      <limit lower="-6.283185" upper="6.283185" effort="50" velocity="3.926" />
    </xacro:joint>

    <xacro:joint name="${prefix}joint5" parent="${prefix}link_4" child="${prefix}link_5">
      <origin xyz="${params.kin_cali.joint5.xyz}" rpy="${params.kin_cali.joint5.rpy}" />
      <axis xyz="0 0 1" />
      <limit lower="-6.283185" upper="6.283185" effort="50" velocity="3.926" />
    </xacro:joint>

    <xacro:joint name="${prefix}joint6" parent="${prefix}link_5" child="${prefix}link_6">
      <origin xyz="${params.kin_cali.joint6.xyz}" rpy="${params.kin_cali.joint6.rpy}" />
      <axis xyz="0 0 1" />
      <limit lower="-6.283185" upper="6.283185" effort="50" velocity="3.926" />
    </xacro:joint>
  </xacro:macro>
</robot>