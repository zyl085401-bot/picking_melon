<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="grass_box">
    <static>true</static>

    <pose>0 0 0.5 0 0 0</pose>

    <link name="grass_box_link">
      <!-- 盒子视觉部分 -->
      <visual name="box_visual">
        <geometry>
          <box>
            <size>6.5 0.15 1</size>
          </box>
        </geometry>
        <material>
          <ambient>0.8 0.8 0.8 1</ambient>
        </material>
      </visual>

      <!-- grass_box 视觉部分 -->
      <visual name="grass_box_visual">
        <geometry>
          <box>
            <size>6.5 0.15 1</size> 
          </box>
        </geometry>
        <material>
          <script>
            <uri>model://grass_box/materials/scripts</uri>
            <uri>model://grass_box/materials/textures</uri>
            <name>grass_box_material</name>
          </script>
        </material>
      </visual>

      <!-- 碰撞体部分 -->
      <collision name="grass_box_collision">
        <geometry>
          <box>
            <size>2 2 2</size>
          </box>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
