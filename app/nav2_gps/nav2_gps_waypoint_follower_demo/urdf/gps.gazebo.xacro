<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">
    <xacro:macro name="gps_gazebo" params="prefix">
        <gazebo reference="${prefix}gps_link">
            <sensor name="${prefix}gps" type="gps">
                <always_on>true</always_on>
                <update_rate>1</update_rate>
                <pose>0 0 0 0 0 0</pose>
                <gps>
                    <position_sensing>
                    <horizontal>
                        <noise type="gaussian">
                        <mean>0.0</mean>
                        <stddev>0.01</stddev>
                        </noise>
                    </horizontal>
                    <vertical>
                        <noise type="gaussian">
                        <mean>0.0</mean>
                        <stddev>0.01</stddev>
                        </noise>
                    </vertical>
                    </position_sensing>
                </gps>
                <plugin name="${prefix}gps_plugin" filename="libgazebo_ros_gps_sensor.so">
                    <ros>
                    <remapping>~/out:=/${prefix}gps/fix</remapping>
                    </ros>
                    <frame_name>${prefix}gps_link</frame_name>
                </plugin>
            </sensor>
        </gazebo>
    </xacro:macro>
</robot>