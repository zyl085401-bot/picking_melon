<?xml version="1.0" ?>
<root>
  <Action ID="FetchImage">
    <description>依据IP从相机获取一张图像消息</description>
    <package_name>papjia_vision_behaviors</package_name>
    <class_name>FetchImageServiceClient</class_name>
    <input name="service_name" type="std::string"/>
    <input name="ip" type="std::string"/>
    <input name="device_name" type="std::string"/>
    <output name="success" type="bool"/>
    <output name="image" type="sensor_msgs::msg::Image"/>
  </Action>
</root>
